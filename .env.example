# Console Firebase → Paramètres du projet → Vos applications → Application Web (SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet
VITE_FIREBASE_APP_ID=
# true = utiliser les émulateurs locaux (npm run emulators)
VITE_FIREBASE_EMULATORS=false
# Optionnel : URL publique utilisée dans les liens / QR codes (sinon l'URL courante)
VITE_PUBLIC_URL=
